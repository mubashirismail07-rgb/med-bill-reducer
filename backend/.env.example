# Backend only. Never place secrets in VITE_* variables.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/medreduce
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
NODE_ENV=development
PORT=5000
# Comma-separated exact frontend origins; no trailing slash.
FRONTEND_URLS=http://localhost:5173,https://med-bill-reducer.vercel.app
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=5
PROCESSING_TIMEOUT_MS=120000
UPLOAD_RETENTION_HOURS=24
# Optional absolute temporary originals directory (default: backend/uploads).
# UPLOAD_DIR=/app/uploads
# Optional currency-specific review thresholds. Disabled by default; not market benchmarks.
HIGH_PRICE_THRESHOLDS={}
# Installed in the Docker image; override for local operating systems if needed.
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
